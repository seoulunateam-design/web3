<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {% render 'fonts' %}
  <style>
    :root { --lav: {{ settings.color_lavender }}; --blush: {{ settings.color_blush }}; --plum: {{ settings.color_plum }}; --cream: {{ settings.color_cream }}; --gold: {{ settings.color_gold }}; --ink: {{ settings.color_ink }}; }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  {% render 'icons' %}
  <div class="page">
    <main id="main">{{ content_for_layout }}</main>
  </div>
</body>
</html>
