{%- comment -%}
  Bundled demo catalogue for the "Create Your Own Box" preview page: real photographs of the pieces, shipped in assets/ (cyo-*.webp).
  Names are placeholders ("Ring 01"...) until real design names are set. Box prices are read from the Shopify product variants whose
  title matches the box name (Hot Pink / Black / Light Pink); without the product they show a dash. With the product selected, the three box variants carry their id and stock so the box can be bought; the pieces are recorded as line item properties.
  Accepts: product (optional)
{%- endcomment -%}
{%- capture boxes_json -%}
{%- liquid
  assign pv = null
  if product
    for v in product.variants
      if v.title == 'Hot Pink' or v.option1 == 'Hot Pink'
        assign pv = v
      endif
    endfor
  endif
  assign ptxt = ''
  assign pcents = 0
  assign vid = 0
  assign vavail = true
  if pv
    assign ptxt = pv.price | money
    assign pcents = pv.price
    assign vid = pv.id
    assign vavail = pv.available
  endif
  assign ptxt_json = ptxt | json
-%}{"id":1,"name":"Hot Pink","swatch":"#d54273","variantId":{{ vid }},"price":{{ pcents }},"priceText":{{ ptxt_json }},"available":{{ vavail }},"order":1,"thumb":{{ 'cyo-box-hotpink.webp' | asset_url | json }},"lidImage":{{ 'cyo-box-hotpink.webp' | asset_url | json }},"boxImage":{{ 'cyo-hero-hotpink.webp' | asset_url | json }},"engraving":{"x":50,"y":36,"rotate":-4,"size":9}},
