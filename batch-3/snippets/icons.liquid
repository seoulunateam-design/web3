<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <radialGradient id="pearl" cx=".35" cy=".3" r=".8">
      <stop offset="0" stop-color="#fff"/><stop offset=".6" stop-color="#f6e9f0"/><stop offset="1" stop-color="#cdb5c6"/>
    </radialGradient>
    <linearGradient id="satin" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fbe3ee"/><stop offset="1" stop-color="#d9c0ee"/>
    </linearGradient>
    <linearGradient id="goldg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e3c995"/><stop offset="1" stop-color="#b78f55"/>
    </linearGradient>
    <mask id="moonmask"><rect width="200" height="340" fill="#fff"/><circle cx="128" cy="154" r="52" fill="#000"/></mask>
    <mask id="crescentmask"><rect width="100" height="100" fill="#fff"/><circle cx="66" cy="38" r="34" fill="#000"/></mask>
    <mask id="logomask"><rect width="100" height="100" fill="#fff"/><circle cx="60" cy="44" r="25" fill="#000"/></mask>

    <!-- brand mark: crescent + sparkle -->
    <symbol id="logo" viewBox="0 0 100 100"><image id="logoImg" href="{{ 'mascot-logo.png' | asset_url }}" width="100" height="100" preserveAspectRatio="xMidYMid meet"/></symbol>
    <symbol id="spark" viewBox="0 0 100 100">
      <path d="M50 0C53 34 66 47 100 50 66 53 53 66 50 100 47 66 34 53 0 50 34 47 47 34 50 0z" fill="currentColor"/>
    </symbol>
    <symbol id="crescent" viewBox="0 0 100 100">
      <circle cx="46" cy="54" r="40" fill="currentColor" mask="url(#crescentmask)"/>
    </symbol>
    <symbol id="heart" viewBox="0 0 24 24">
      <path d="M12 21s-8-5.200-8-11a4.500 4.500 0 0 1 8-2.800A4.500 4.500 0 0 1 20 10c0 5.800-8 11-8 11z" fill="currentColor"/>
    </symbol>

    <!-- accessory 1: satin bow charm -->
    <symbol id="cup" viewBox="0 0 200 340">
      <circle cx="100" cy="22" r="14" fill="none" stroke="url(#goldg)" stroke-width="5"/>
      <path d="M100 36V104" stroke="url(#goldg)" stroke-width="3" stroke-dasharray="6 4"/>
      <path d="M100 160C70 108 18 116 20 158c2 42 52 46 80 2z" fill="url(#satin)" stroke="#b995cf" stroke-width="2"/>
      <path d="M100 160c30-52 82-44 80-2-2 42-52 46-80 2z" fill="url(#satin)" stroke="#b995cf" stroke-width="2"/>
      <path d="M92 170 62 248l24-11 12 20 6-84z" fill="#efcfe0" stroke="#d3a9c7" stroke-width="1.5"/>
      <path d="M108 170l30 78-24-11-12 20-6-84z" fill="#efcfe0" stroke="#d3a9c7" stroke-width="1.5"/>
      <ellipse cx="100" cy="160" rx="17" ry="22" fill="#51334F"/>
      <path d="M100 148c1 5 3 7 8 8-5 1-7 3-8 8-1-5-3-7-8-8 5-1 7-3 8-8z" fill="#C6A36B"/>
      <path d="M100 182V288" stroke="url(#goldg)" stroke-width="3" stroke-dasharray="5 4" opacity=".0"/>
      <path d="M100 262V296" stroke="url(#goldg)" stroke-width="3"/>
      <circle cx="100" cy="314" r="20" fill="url(#pearl)" stroke="#d9c6d2" stroke-width="1.5"/>
      <ellipse cx="93" cy="306" rx="6" ry="4" fill="#fff" opacity=".85"/>
    </symbol>

    <!-- accessory 2: moon drop earring -->
    <symbol id="cup2" viewBox="0 0 200 340">
      <path d="M100 6c-20 0-20 30 0 30" fill="none" stroke="url(#goldg)" stroke-width="5" stroke-linecap="round"/>
      <path d="M100 36V96" stroke="url(#goldg)" stroke-width="3"/>
      <circle cx="100" cy="164" r="64" fill="url(#satin)" mask="url(#moonmask)"/>
      <circle cx="100" cy="164" r="64" fill="none" stroke="#b995cf" stroke-width="2" mask="url(#moonmask)"/>
      <path d="M146 150c1 8 5 12 13 13-8 1-12 5-13 13-1-8-5-12-13-13 8-1 12-5 13-13z" fill="#C6A36B"/>
      <path d="M100 228V272" stroke="url(#goldg)" stroke-width="3"/>
      <circle cx="100" cy="296" r="24" fill="url(#pearl)" stroke="#d9c6d2" stroke-width="1.5"/>
      <ellipse cx="92" cy="287" rx="7" ry="4.5" fill="#fff" opacity=".85"/>
    </symbol>
  </defs>
