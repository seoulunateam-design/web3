{%- comment -%}
  Shows line item properties (e.g. the Build Your Own Box choices). Properties whose name starts with "_" are hidden, as in Shopify's own convention.
{%- endcomment -%}
{%- for prop in item.properties -%}
  {%- assign first_char = prop.first | slice: 0 -%}
  {%- if first_char != '_' and prop.last != blank -%}
    <small class="line__prop"><span>{{ prop.first }}:</span> {{ prop.last }}</small>
  {%- endif -%}
{%- endfor -%}
