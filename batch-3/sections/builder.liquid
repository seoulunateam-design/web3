{%- comment -%}
  Build Your Own Box: interactive customizer.
  Catalogue (boxes, categories, designs) comes from metaobjects; price and stock come from Shopify variants.
  Logic: assets/builder.js. Styling: assets/builder.css. Data: snippets/builder-data.liquid.
  Setup steps: BUILDER-SETUP.md in the theme root.
{%- endcomment -%}
{%- assign byob_product = section.settings.product -%}
{%- unless section.settings.enable_purchasing or section.settings.preview_only -%}
  {%- comment -%}Purchasing is OFF: show the Coming Soon panel only. No builder markup, no add to bag. The full builder below is kept for future activation.{%- endcomment -%}
  <div class="byob byob--soon" {{ section.shopify_attributes }}>
    <div class="byob__head">
      {%- if section.settings.kicker != blank -%}<p class="byob__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    </div>
    {%- render 'byob-coming-soon' -%}
  </div>
{%- else -%}
<div class="byob" data-byob {{ section.shopify_attributes }}>
  <div class="byob__head">
    {%- if section.settings.kicker != blank -%}<p class="byob__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.tagline != blank -%}<p class="byob__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
  </div>

  <div class="byob__grid">
    <div class="byob__stagecol">
      <div class="stage" data-stage aria-label="{{ section.settings.preview_label | escape }}">
        <div class="stage__frame" data-stage-frame>
          <img class="stage__box" data-stage-box src="{{ 'builder-placeholder.svg' | asset_url }}" alt="" width="800" height="600">
          <div class="stage__slots" data-stage-slots></div>
        </div>
        <div class="lid" data-lid>
          <img class="lid__img" data-lid-img src="{{ 'builder-placeholder.svg' | asset_url }}" alt="" width="400" height="300" loading="lazy">
          <span class="lid__text" data-lid-text aria-hidden="true"></span>
        </div>
      </div>
      <p class="byob__note" data-stage-note></p>
    </div>

    <div class="panel" data-panel>
      <section class="step" aria-labelledby="byob-s1">
        <h2 id="byob-s1"><i>1</i>{{ section.settings.step1_title }}</h2>
        <div class="boxes" data-boxes role="radiogroup" aria-labelledby="byob-s1"></div>
      </section>

      <section class="step" aria-labelledby="byob-s2">
        <h2 id="byob-s2"><i>2</i>{{ section.settings.step2_title }}</h2>
        <p class="step__sub">{{ section.settings.step2_sub }}</p>
        <div class="cats" data-cats></div>
        <div class="designs" data-designs hidden aria-live="polite"></div>
      </section>

      <section class="step" aria-labelledby="byob-s3">
        <h2 id="byob-s3"><i>3</i>{{ section.settings.step3_title }}</h2>
        <label class="engrave">
          <span class="visually-hidden">{{ section.settings.engraving_label }}</span>
          <input type="text" data-name maxlength="15" autocomplete="off" spellcheck="false" placeholder="{{ section.settings.engraving_placeholder | escape }}">
          <small data-name-count>0 / 15</small>
        </label>
        <p class="step__sub">{{ section.settings.engraving_note }}</p>
      </section>

      <div class="bar" data-bar>
        <div class="bar__progress">
          <span data-progress-text></span>
          <span class="bar__dots" data-dots aria-hidden="true"></span>
        </div>
        <div class="bar__buy">
          <div class="bar__price"><small>{{ section.settings.price_label }}</small><b data-price>—</b></div>
          <button type="button" class="bar__add" data-add disabled>{{ section.settings.add_label }}</button>
        </div>
        <p class="bar__msg" data-msg role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>

  {%- if request.design_mode and shop.metaobjects.byob_box.values.size == 0 and byob_product == blank -%}
    <p class="byob__setup"><mark class="tbc">Setup needed (visible only in the theme editor): choose the "Build Your Own Box" product in this section's settings and create the metaobjects described in BUILDER-SETUP.md.</mark></p>
  {%- endif -%}

  <script type="application/json" data-byob-data>{% render 'builder-data', product: byob_product, bundled: section.settings.bundled_catalogue %}</script>
  <script type="application/json" data-byob-strings>
    {
      "soldOut": {{ section.settings.sold_out_label | json }},
      "chooseMore": {{ section.settings.choose_more | json }},
      "noDesigns": {{ section.settings.no_designs | json }},
      "noBoxes": {{ section.settings.no_boxes | json }},
      "added": {{ section.settings.added_label | json }},
      "addLabel": {{ section.settings.add_label | json }},
      "stockChanged": {{ section.settings.stock_changed | json }},
      "piecesSelected": {{ section.settings.pieces_selected | json }},
      "placeholderNote": {{ section.settings.placeholder_note | json }},
      "yourName": {{ section.settings.preview_name_hint | json }},
      "previewOnly": {{ section.settings.preview_only | json }},
      "previewLabel": {{ section.settings.preview_button | json }},
      "previewDone": {{ section.settings.preview_done | json }},
      "productTitle": {{ byob_product.title | default: section.settings.heading | json }}
    }
  </script>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Build Your Own Box",
  "settings": [
    { "type": "header", "content": "Launch switch" },
    { "type": "checkbox", "id": "enable_purchasing", "label": "Enable purchasing", "default": false, "info": "OFF = the page shows Coming Soon and nothing can be bought. Turn on only after the inventory setup in BUILDER-SETUP.md has been verified." },
    { "type": "checkbox", "id": "preview_only", "label": "Preview only (design the box, but nothing can be bought)", "default": false, "info": "Shows the full builder with a disabled button. No cart or checkout action is possible." },
    { "type": "checkbox", "id": "bundled_catalogue", "label": "Use the bundled demo catalogue photos", "default": false, "info": "Real piece photos shipped with the theme (cyo-*.webp). Switch off once your metaobject catalogue is ready." },
    { "type": "text", "id": "preview_button", "label": "Disabled button text (preview only)", "default": "COMING SOON" },
    { "type": "text", "id": "preview_done", "label": "Message when all six pieces are chosen (preview only)", "default": "Lovely choice! Ordering opens soon." },
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Build Your Own Box product", "info": "Its variants are the box options (Hot Pink, Black, Light Pink) and carry the price and stock. Used directly if no box metaobjects exist yet." },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "SEOULUNA" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Build Your Own Box" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "A little world, made by you." },
    { "type": "header", "content": "Steps" },
    { "type": "text", "id": "step1_title", "label": "Step 1 title", "default": "Choose Your Box" },
    { "type": "text", "id": "step2_title", "label": "Step 2 title", "default": "Choose Your Six Pieces" },
    { "type": "text", "id": "step2_sub", "label": "Step 2 note", "default": "Select one design from each category (6 in total). All six are included in the box price." },
    { "type": "text", "id": "step3_title", "label": "Step 3 title", "default": "Personalize Your Box" },
    { "type": "text", "id": "engraving_label", "label": "Engraving field label (screen readers)", "default": "Name for gold engraving" },
    { "type": "text", "id": "engraving_placeholder", "label": "Engraving placeholder", "default": "Name for gold engraving (optional)" },
    { "type": "text", "id": "engraving_note", "label": "Engraving note", "default": "Optional. Up to 15 characters: letters, spaces and . , ' - & ! ?" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "preview_label", "label": "Preview (screen readers)", "default": "Live preview of your box" },
    { "type": "text", "id": "preview_name_hint", "label": "Lid text shown before a name is typed", "default": "" },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "Your Box" },
    { "type": "text", "id": "add_label", "label": "Add to bag button", "default": "ADD TO BAG" },
    { "type": "text", "id": "added_label", "label": "Added message", "default": "Your box was added to the bag" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "choose_more", "label": "Missing pieces message", "default": "Choose {n} more to continue", "info": "{n} is replaced by the number still missing." },
    { "type": "text", "id": "pieces_selected", "label": "Progress text", "default": "{n} of 6 pieces selected", "info": "{n} is replaced by the number chosen." },
    { "type": "text", "id": "no_designs", "label": "No designs message", "default": "No designs available in this category yet." },
    { "type": "text", "id": "no_boxes", "label": "No boxes message", "default": "Boxes are not available right now." },
    { "type": "text", "id": "stock_changed", "label": "Stock changed message", "default": "One of your pieces just sold out. Please choose another design." },
    { "type": "text", "id": "placeholder_note", "label": "Note shown while real photographs are missing", "default": "Preview photographs coming soon." }
  ],
  "presets": [{ "name": "Build Your Own Box" }]
}
{% endschema %}
