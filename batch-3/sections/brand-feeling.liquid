<section class="feeling" data-reveal {{ section.shopify_attributes }}>
  <h2>{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
  {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "Brand statement",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "MORE THAN ACCESSORIES." },
    { "type": "text", "id": "accent", "label": "Heading accent (gold italic)", "default": "A FEELING." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From the moment you discover your collection to the excitement of unboxing it, every detail is designed to bring you a little moment of joy." }
  ],
  "presets": [{ "name": "Brand statement" }]
}
{% endschema %}
