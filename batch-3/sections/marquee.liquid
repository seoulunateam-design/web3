{%- comment -%} Brand strip: an endless scrolling band. The track holds two identical halves so it loops seamlessly. {%- endcomment -%}
<div class="strip" aria-hidden="true" {{ section.shopify_attributes }}>
  <div class="strip__track">
    {%- for i in (1..32) -%}
      <span>{{ section.settings.text }}</span><i>✦</i>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Brand strip",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "SEOULUNA" }
  ],
  "presets": [{ "name": "Brand strip" }]
}
{% endschema %}
