{%- comment -%}
  Bestsellers. Real Shopify products, prices and images. Choose a collection in the section settings (e.g. one you maintain called "Bestsellers").
  Without a choice it tries a collection with the handle "bestsellers", then falls back to all products.
{%- endcomment -%}
{%- liquid
  assign src = section.settings.collection
  if src == blank
    assign src = collections['bestsellers']
  endif
  if src == blank or src.products_count == 0
    assign src = collections.all
  endif
-%}
{%- if src.products_count > 0 -%}
<section class="bs" id="bestsellers" {{ section.shopify_attributes }}>
  <div class="bs__head" data-reveal>
    {%- if section.settings.kicker != blank -%}<p class="bs__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="cg cg--bs" data-stagger>
    {%- for product in src.products limit: section.settings.limit -%}
      {%- render 'product-tile', product: product, index: forloop.index0 -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.button_label != blank -%}
    <p class="bs__more"><a class="btn btn--ghost" href="{{ src.url }}">{{ section.settings.button_label }}</a></p>
  {%- endif -%}
</section>
{%- elsif request.design_mode -%}
  <p class="editor-hint">Bestsellers: add products to your store (or choose a collection) to show them here.</p>
{%- endif -%}

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "LOVED RIGHT NOW" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use a collection with the handle \"bestsellers\", or all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "VIEW ALL" }
  ],
  "presets": [{ "name": "Bestsellers" }]
}
{% endschema %}
