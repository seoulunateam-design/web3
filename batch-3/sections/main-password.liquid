<section class="shop-page password-page" {{ section.shopify_attributes }}>
  <div class="password-card">
    <svg class="footer__logo" aria-hidden="true"><use href="#logo"/></svg>
    <h1>{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p class="ov__empty">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label>ENTER STORE PASSWORD<input type="password" name="password" autocomplete="current-password" required></label>
      <button class="btn btn--plum" type="submit">ENTER</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page"
}
{% endschema %}
