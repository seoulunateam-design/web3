{%- comment -%}Brand story: editorial two-picture layout. Pictures from the settings, otherwise the bundled brand photos.{%- endcomment -%}
<section class="story" id="story" {{ section.shopify_attributes }}>
  <div class="story__pics" data-reveal="left">
    <figure class="story__pic story__pic--a">
      {%- if section.settings.image_1 != blank -%}{{ section.settings.image_1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 861px) 380px, 70vw', alt: section.settings.image_1.alt | default: '' }}
      {%- else -%}<img src="{{ 'reel-05.jpg' | asset_url }}" alt="" width="400" height="500" loading="lazy" decoding="async">{%- endif -%}
    </figure>
    <figure class="story__pic story__pic--b">
      {%- if section.settings.image_2 != blank -%}{{ section.settings.image_2 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 861px) 260px, 50vw', alt: section.settings.image_2.alt | default: '' }}
      {%- else -%}<img src="{{ 'box-lightpink-lifestyle.jpg' | asset_url }}" alt="" width="400" height="500" loading="lazy" decoding="async">{%- endif -%}
    </figure>
  </div>
  <div class="story__copy" data-reveal="right">
    {%- if section.settings.kicker != blank -%}<p class="story__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="story__text">{{ section.settings.text | newline_to_br }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="btn btn--plum" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "OUR STORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little Seoul, a lot of you." },
    { "type": "textarea", "id": "text", "label": "Story", "info": "Write your own story here. It is shown exactly as typed.", "default": "SEOULUNA is Korean-inspired fashion and accessories, designed to feel personal. Pieces you can mix, layer and make your own." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image_1", "label": "Large photo", "info": "Portrait 4:5. Empty = bundled brand photo." },
    { "type": "image_picker", "id": "image_2", "label": "Small photo" }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}
