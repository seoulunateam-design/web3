<header class="nav" id="nav" data-section-id="{{ section.id }}">
  <a class="nav__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    {%- if settings.logo -%}
      {{ settings.logo | image_url: width: 120 | image_tag: width: 52, height: 52, alt: shop.name }}
    {%- else -%}
      <svg aria-hidden="true"><use href="#logo"/></svg>
    {%- endif -%}
    <img class="nav__wordmark" src="data:image/png;base64," alt="{{ shop.name | escape }}" width="108" height="36">
  </a>

  <nav class="nav__pill" id="navPill" aria-label="{{ 'general.main_menu' | t }}">
    {%- for link in linklists[section.settings.menu].links -%}
      {%- if link.links.size > 0 -%}
        <div class="has-dd">
          <a href="{{ link.url }}"{% if link.active or link.child_active %} class="active"{% endif %}>{{ link.title }}</a>
          <div class="dd">
            {%- for child in link.links -%}
              <a href="{{ child.url }}">{{ child.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>

  <div class="nav__icons">
    <a href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4-4"/></svg>
    </a>
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" id="account" aria-label="{{ 'general.account' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.500 3.500-7 8-7s8 2.500 8 7"/></svg>
      </a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" class="cart" id="bag" data-cart-open aria-label="{{ 'cart.title' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      <span data-cart-count id="cartCount">{{ cart.item_count }}</span>
    </a>
    <button class="burger" id="burger" type="button" aria-label="{{ 'general.menu' | t }}" aria-expanded="false" aria-controls="navPill"><i></i><i></i></button>
  </div>
</header>

{% style %}
/* Clean jewellery-brand header: transparent, charcoal text, underline for active link */
#shopify-section-header { position: sticky; top: 0; z-index: 60; --hd-ink: #2B2B2B; --hd-ivory: #FFFBF5; --hd-line: rgba(43, 43, 43, .12); }
#shopify-section-header .nav {
  position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  padding: 12px 40px; background: transparent; border-bottom: 1px solid transparent;
  box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none;
  transition: background .4s, border-color .4s, box-shadow .4s, backdrop-filter .4s;
}
/* transparent at the top of the page; soft ivory glass once you scroll so it stays readable */
#shopify-section-header .nav.scrolled { background: rgba(255, 251, 245, .86); border-bottom-color: var(--hd-line); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); box-shadow: 0 6px 20px rgba(43, 43, 43, .06); padding-top: 12px; padding-bottom: 12px; }
#shopify-section-header .nav__logo { justify-self: start; gap: 10px; }
#shopify-section-header .nav__logo img, #shopify-section-header .nav__logo svg { width: 40px; height: 40px; object-fit: contain; --logo-disc: var(--hd-ink); --logo-moon: var(--hd-ivory); --logo-accent: var(--gold); }
/* wordmark image (white PNG) shown in charcoal */
#shopify-section-header .nav .nav__wordmark { height: 36px; width: auto; object-fit: contain; filter: brightness(0); opacity: .88; }
#shopify-section-header .nav .nav__pill {
  justify-self: center; width: auto; gap: 36px; padding: 0; background: transparent; border: 0; box-shadow: none;
  backdrop-filter: none; -webkit-backdrop-filter: none; justify-content: center;
}
#shopify-section-header .nav__pill > a, #shopify-section-header .has-dd { flex: none; }
#shopify-section-header .nav .nav__pill a { padding: 8px 2px; border-radius: 0; background: transparent; color: var(--hd-ink); font-size: 13px; font-weight: 500; letter-spacing: 1.2px; }
#shopify-section-header .nav .nav__pill a::after { left: 0; right: 0; bottom: 2px; height: 1px; background: var(--hd-ink); transform: scaleX(0); }
#shopify-section-header .nav .nav__pill a:hover::after { transform: scaleX(1); }
#shopify-section-header .nav .nav__pill a.active { background: transparent; color: var(--hd-ink); font-weight: 600; }
#shopify-section-header .nav .nav__pill a.active::after { display: block; transform: scaleX(1); }
#shopify-section-header .nav .nav__pill .dd a { padding: 10px 14px; color: var(--hd-ink); }
#shopify-section-header .nav .nav__pill .dd a::after { display: none; }
#shopify-section-header .nav .nav__icons { justify-self: end; gap: 6px; color: var(--hd-ink); }
#shopify-section-header .nav__icons a { width: 38px; height: 38px; align-items: center; justify-content: center; }
#shopify-section-header .nav__icons svg { width: 22px; height: 22px; }
#shopify-section-header .nav .cart { background: transparent; color: var(--hd-ink); border-radius: 0; width: 38px; height: 38px; }
#shopify-section-header .nav .cart svg { width: 22px; height: 22px; }
#shopify-section-header .nav .cart span { top: 2px; right: 0; background: var(--hd-ink); color: var(--hd-ivory); min-width: 16px; height: 16px; font-size: 9px; border-radius: 8px; }
#shopify-section-header .nav .burger i { background: var(--hd-ink); }
@media (max-width: 860px) {
  #shopify-section-header .nav { display: flex; align-items: center; padding: 8px 14px; min-height: 56px; }
  #shopify-section-header .nav__logo { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  #shopify-section-header .nav__logo img, #shopify-section-header .nav__logo svg { width: 34px; height: 34px; }
  #shopify-section-header .nav .nav__wordmark { height: 28px; }
  #shopify-section-header .nav .nav__icons { display: contents; }
  #shopify-section-header .burger { order: -1; margin-right: auto; }
  #shopify-section-header .nav__icons a { width: 34px; height: 34px; }
  #shopify-section-header .nav .nav__pill {
    position: absolute; top: 100%; left: 0; right: 0; width: auto; flex-direction: column; gap: 0; padding: 8px 20px 14px;
    background: var(--hd-ivory); border-bottom: 1px solid var(--hd-line); border-radius: 0;
  }
  #shopify-section-header .nav .nav__pill a { padding: 14px 0; font-size: 14px; text-align: left; }
  #shopify-section-header .nav .nav__pill a::after { left: 0; right: auto; width: 28px; bottom: 8px; }
}
@media (max-width: 400px) { #shopify-section-header .nav .nav__wordmark { height: 24px; } }
{% endstyle %}

{%- if template.name == 'index' -%}
{% style %}
/* Homepage: header floats over the hero so its pink background runs behind it */
body.template-index { --hh: 70px; }
#shopify-section-header { height: 0; }
#shopify-section-header .nav { position: absolute; top: 0; left: 0; right: 0; }
body.template-index .world { top: 0; }
body.template-index .hero { min-height: calc(640px + var(--hh)); padding-top: calc(40px + var(--hh)); }
body.template-index .hero__panel { top: var(--hh); }
body.template-index .hero__thumbs { top: calc(440px + var(--hh)); }
@media (max-width: 860px) {
  body.template-index { --hh: 58px; }
  body.template-index .hero { min-height: 0; padding-top: calc(20px + var(--hh)); }
  body.template-index .hero__panel { top: auto; }
  body.template-index .hero__thumbs { top: 0; }
}
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
