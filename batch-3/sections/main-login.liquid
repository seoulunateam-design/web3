<section class="shop-page auth-page" {{ section.shopify_attributes }}>
  <div class="auth-card" id="loginPanel">
    <h1>Sign in</h1>
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label>EMAIL<input type="email" name="customer[email]" autocomplete="email" required></label>
      <label>PASSWORD<input type="password" name="customer[password]" autocomplete="current-password" required></label>
      <button class="btn btn--plum btn--block" type="submit">SIGN IN</button>
    {%- endform -%}
    <p class="auth-links">
      <a href="#recover" data-toggle-recover>Forgot your password?</a>
      <a href="{{ routes.account_register_url }}">Create account</a>
    </p>
  </div>

  <div class="auth-card" id="recover" hidden>
    <h2>Reset your password</h2>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-ok" role="status">We've sent you an email with a link to reset your password.</p>
      {%- endif -%}
      {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label>EMAIL<input type="email" name="email" autocomplete="email" required></label>
      <button class="btn btn--plum btn--block" type="submit">SEND RESET LINK</button>
    {%- endform -%}
    <p class="auth-links"><a href="#loginPanel" data-toggle-recover>Back to sign in</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Login"
}
{% endschema %}
