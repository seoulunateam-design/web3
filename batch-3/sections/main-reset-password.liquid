<section class="shop-page auth-page" {{ section.shopify_attributes }}>
  <div class="auth-card">
    <h1>Reset password</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label>NEW PASSWORD<input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label>CONFIRM PASSWORD<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button class="btn btn--plum btn--block" type="submit">RESET PASSWORD</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Reset password"
}
{% endschema %}
