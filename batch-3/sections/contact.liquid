<section class="contact" id="contact" {{ section.shopify_attributes }}>
  {%- if section.settings.heading != blank -%}
    <div class="final" data-reveal><p>{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></p></div>
  {%- endif -%}
  {%- assign sent = false -%}
  {%- form 'contact', id: 'ContactForm', class: 'form' -%}
    {%- if form.posted_successfully? -%}{%- assign sent = true -%}{%- endif -%}
    <h3>CONTACT</h3>
    {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label>NAME:<input name="contact[name]" type="text" placeholder="ENTER YOUR NAME..." autocomplete="name" required></label>
    <label>EMAIL:<input name="contact[email]" type="email" placeholder="ENTER YOUR EMAIL..." autocomplete="email" required></label>
    <label>MESSAGE:<textarea name="contact[body]" rows="3" placeholder="HOW CAN WE HELP?" required></textarea></label>
    <button class="btn btn--plum" type="submit">SUBMIT</button>
  {%- endform -%}
  <div class="thanks{% if sent %} pulse{% endif %}" id="thanks">
    {%- if sent -%}
      <h3>THANK YOU!</h3>
      <p>{{ section.settings.sent_text }}</p>
    {%- else -%}
      <h3>{{ section.settings.idle_heading }}</h3>
      <p>{{ section.settings.idle_text }}</p>
    {%- endif -%}
    <a class="thanks__go" href="{{ routes.collections_url }}" aria-label="Browse collections">&rarr;</a>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "YOUR SEOUL MOMENT" },
    { "type": "text", "id": "accent", "label": "Heading accent (gold italic)", "default": "STARTS HERE." },
    { "type": "text", "id": "idle_heading", "label": "Panel heading", "default": "SAY HELLO" },
    { "type": "text", "id": "idle_text", "label": "Panel text", "default": "Send us a message and we'll get back to you." },
    { "type": "text", "id": "sent_text", "label": "Text after a message is sent", "default": "Your message has been sent. We'll be in touch soon." }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
