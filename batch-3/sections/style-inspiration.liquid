{%- comment -%}
  Style inspiration: model and styling photography. Add "Look" blocks with your own photos (and optional links, e.g. to a product).
  With no blocks it shows bundled brand photographs.
{%- endcomment -%}
<section class="style" id="style" {{ section.shopify_attributes }}>
  <div class="style__head" data-reveal>
    {%- if section.settings.kicker != blank -%}<p class="bs__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="style__grid" data-stagger>
    {%- assign has_blocks = false -%}
    {%- for block in section.blocks -%}{%- if block.settings.image != blank -%}{%- assign has_blocks = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          {%- assign tile_alt = block.settings.image.alt | default: block.settings.caption -%}
          {%- if block.settings.link != blank -%}<a class="style__tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- else -%}<figure class="style__tile" {{ block.shopify_attributes }}>{%- endif -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 861px) 300px, 46vw', alt: tile_alt }}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- else -%}</figure>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- assign fallback = '05,08,17,22,11' | split: ',' -%}
      {%- for n in fallback -%}
        {%- assign file = 'reel-' | append: n | append: '.jpg' -%}
        <figure class="style__tile"><img src="{{ file | asset_url }}" alt="" width="400" height="500" loading="lazy" decoding="async"></figure>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Style inspiration",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "STYLE INSPIRATION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear it your way" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Layer, mix and make every piece your own." }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Portrait 4:5." },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Style inspiration" }]
}
{% endschema %}
